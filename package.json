{
  "name": "reprox",
  "version": "dev",
  "type": "module",
  "description": "Serverless APT/RPM Repository Gateway using Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "postinstall": "node scripts/extract-xz-wasm.cjs",
    "build:readme": "npx tsx scripts/build-readme.ts",
    "dev": "npm run build:readme && wrangler dev",
    "predeploy": "npm run build:readme",
    "deploy": "wrangler deploy",
    "preupload": "npm run build:readme",
    "upload": "wrangler versions upload",
    "pretest": "npm run build:readme",
    "test": "vitest",
    "typecheck": "npm run build:readme && tsc --noEmit"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "openpgp": "^6.3.1",
    "xzwasm": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.12",
    "@cloudflare/workers-types": "^5.20260917.1",
    "cssnano": "^9.0.5",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "marked-alert": "^2.1.2",
    "marked-gfm-heading-id": "^4.1.4",
    "postcss": "^8.5.28",
    "purgecss": "^8.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
